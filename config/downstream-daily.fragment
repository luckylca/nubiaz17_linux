# NX563J daily-driver combined config fragment — the single fragment fed to
# build-downstream.yml (which merges exactly ONE fragment per build).
# Concatenation of, and kept in sync with:
#   config/downstream-usb-diag.fragment   (gadget serial/ecm for ssh+diag)
#   config/downstream-bt.fragment         (WCN3990 HCIUART + RFCOMM/BNEP/HIDP)
#   config/downstream-nethunter-wifi.fragment (external USB Wi-Fi, Phase 5)
#   config/downstream-nethunter-misc.fragment (USB BT/CAN/NFS, Phases 8/9/12)
# See those files for the full per-option rationale. Rules carried over:
# keep CONFIG_* tokens out of comment text; no USB_G_SERIAL/USB_G_NCM
# (configfs choice conflict); no RNDIS (multi-composite link error).

# --- usb-diag ----------------------------------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y

# --- bt ----------------------------------------------------------
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y

# --- nethunter-wifi (Phase 5) ------------------------------------
CONFIG_MAC80211=y
CONFIG_ATH9K_HTC=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y

# --- nethunter-misc (Phases 8/9/12) ------------------------------
CONFIG_BT_HCIBTUSB=y
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_BCM=y
CONFIG_CAN_GS_USB=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_V4=y
CONFIG_ROOT_NFS=n

# --- docker (容器, 2026-09-18) ------------------------------------
# 对照 moby check-config.sh "Generally Necessary" + 常用 Optional。
# 现状(20260915 dist 内核)缺: PID_NS/VETH/POSIX_MQUEUE/
# DEVPTS_MULTIPLE_INSTANCES 等关键项, 以下为补全。全部 in-tree, 无补丁。
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
# 注意: 不加 CFS_BANDWIDTH——本树(CAF 魔改 4.4)fair.c 的 bandwidth 代码
# 残缺, 开即编译失败(CI run 35293317030)。影响仅 docker --cpu-quota 不可用,
# --cpu-shares(FAIR_GROUP_SCHED)正常。
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_MEMCG_KMEM=y
CONFIG_VETH=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_CT_NETLINK=y
