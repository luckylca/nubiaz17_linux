# devices.yml entry for Nubia Z17 (nx563j) — to be merged into
# kali-nethunter-kernels/devices.yml (submission via GitLab MR, see
# docs/KALI_NETHUNTER_PORT.md phase K6).
#
# features policy: only capabilities verified on real hardware are listed.
# HID-4 + internal QCACLD injection were re-verified on Android/NetHunter
# on 2026-09-17. BT_RFCOMM was end-to-end verified on 2026-09-20 against
# a rooted Android peer, including bidirectional RFCOMM payload/ACK traffic.
# NFS was hardware-verified on NX563J against a macOS NFS server; the current
# NetHunter kernel also carries NFS v2/v3/v4 client support. External-adapter
# labels (RTL88XXAU etc.) are omitted until OTG hardware arrives.
# CDROM was hardware-verified on 2026-09-20: macOS enumerated the configfs
# mass-storage LUN with cdrom=1 as a real `File-CD Gadget` (0930:6545).
# Docker was fully validated on the formal nethunter-22.2 promotion kernel
# (a180aa33): runtime, cgroups, bridge networking, slirp uplink/hostfwd,
# public IPv4, DNS and domain HTTP all passed on real NX563J hardware.

- nx563j:
    model  : Nubia Z17
    images :
      - id     : nx563j-los
        name   : Nubia Z17 (LineageOS 22.2)
        android: fifteen
        note   : >-
                 Internal Wi-Fi injection is validated on 5 GHz. 2.4 GHz
                 injection is currently avoided because the WCN3990 firmware
                 can assert under that path.
    kernels:
      - id          : nx563j-los
        description : Nubia Z17 for LineageOS
        kernelstring: NetHunter Kernel for Nubia Z17
        arch        : arm64
        devicenames : nx563j,NX563J
        block       : /dev/block/bootdevice/by-name/boot
        slot_device : 0
        versions    :
          - android    : fifteen
            linux      : 4.04
            description: LineageOS 22.2
            author     : luckylca
            source     : 'git clone https://github.com/luckylca/android_kernel_nubia_msm8998_nethunter -b nethunter-22.2'
            features   : [BT_RFCOMM, CDROM, Docker, HID-4, Injection, QCACLD, Internal_BT, NFS]
