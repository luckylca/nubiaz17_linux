#!/bin/sh
# NX563J diagnostic initramfs init.
#
# Goal: prove the replacement kernel and userspace run even when the panel
# stays dark. Brings up a USB composite gadget (serial console + USB network
# + read-only log LUN where the kernel supports it), dumps boot diagnostics,
# and stays alive so the host can connect.

PATH=/bin:/sbin:/usr/bin:/usr/sbin
LOG=/boot_log.txt
UDC=""

log() {
  echo "$@" | tee -a "$LOG"
}

run_logged() {
  log "== $* =="
  "$@" >> "$LOG" 2>&1
  tail -n 40 "$LOG" | sed 's/^/  /'
}

# --- basic mounts -----------------------------------------------------------
/bin/busybox --install -s /bin >>"$LOG" 2>&1

mount -t proc proc /proc
mount -t sysfs sysfs /sys

if ! mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
  mount -t tmpfs tmpfs /dev
  mknod -m 600 /dev/console c 5 1
  mknod -m 666 /dev/null c 1 3
  mknod -m 666 /dev/zero c 1 5
  mdev -s
fi

mkdir -p /config /mnt/logdisk
mount -t configfs none /config 2>/dev/null || true

exec 0</dev/console 1>/dev/console 2>/dev/console

log "NX563J Linux initramfs started"
log "date: $(date 2>/dev/null)"

# --- early diagnostics ------------------------------------------------------
run_logged uname -a
run_logged cat /proc/cmdline
run_logged cat /proc/meminfo
log "== /sys/class/block =="
ls -la /sys/class/block 2>&1 | tee -a "$LOG"
log "== /dev (block and ttyGS) =="
ls -la /dev 2>&1 | grep -E "block|ttyGS|sd|ufs" | tee -a "$LOG"
ls /sys/class/udc 2>/dev/null | tee -a "$LOG"

# --- USB gadget -------------------------------------------------------------
G=/config/usb_gadget/nx563j
setup_gadget() {
  [ -d /config/usb_gadget ] || { log "configfs usb_gadget unavailable"; return 1; }
  mkdir -p "$G"
  cd "$G" || return 1

  echo 0x1d6b > idVendor   # Linux Foundation
  echo 0x0104 > idProduct  # Multifunction Composite Gadget
  echo 0x0100 > bcdDevice
  echo 0x0200 > bcdUSB
  mkdir -p strings/0x409
  echo "nx563j-diag-0001" > strings/0x409/serialnumber
  echo "nubia-linux" > strings/0x409/manufacturer
  echo "NX563J diagnostic gadget" > strings/0x409/product

  # Serial console (preferred interactive channel).
  mkdir -p functions/acm.GS0 2>/dev/null && log "gadget: acm.GS0 ok"

  # USB network: try NCM, ECM, RNDIS in order; keep the first that works.
  NETFUNC=""
  for f in ncm.usb0 ecm.usb0 rndis.usb0; do
    if mkdir -p "functions/$f" 2>/dev/null; then
      NETFUNC="$f"
      log "gadget: net function $f ok"
      break
    fi
  done

  # Read-only log LUN as last-resort exfiltration.
  if mkdir -p functions/mass_storage.usb0 2>/dev/null; then
    dd if=/dev/zero of=/logdisk.img bs=1M count=8 2>/dev/null
    mkfs.vfat /logdisk.img >>"$LOG" 2>&1
    dmesg > /dmesg-early.txt 2>&1
    if mount -o loop /logdisk.img /mnt/logdisk 2>/dev/null; then
      cp "$LOG" /dmesg-early.txt /mnt/logdisk/ 2>/dev/null
      umount /mnt/logdisk
    fi
    echo 1 > functions/mass_storage.usb0/lun.0/ro
    echo 0 > functions/mass_storage.usb0/lun.0/nofua
    echo /logdisk.img > functions/mass_storage.usb0/lun.0/file
    log "gadget: mass_storage.usb0 ok (read-only log LUN)"
  fi

  mkdir -p configs/c.1/strings/0x409
  echo "nx563j diag" > configs/c.1/strings/0x409/configuration
  echo 500 > configs/c.1/MaxPower

  [ -d functions/acm.GS0 ] && ln -sf functions/acm.GS0 configs/c.1/
  [ -n "$NETFUNC" ] && ln -sf "functions/$NETFUNC" configs/c.1/
  [ -d functions/mass_storage.usb0 ] && ln -sf functions/mass_storage.usb0 configs/c.1/

  UDC=$(ls /sys/class/udc 2>/dev/null | head -n 1)
  if [ -z "$UDC" ]; then
    log "gadget: no UDC found"
    return 1
  fi
  echo "$UDC" > UDC
  log "gadget: bound to UDC $UDC"
  return 0
}

if setup_gadget; then
  sleep 3

  # Serial console shell.
  if [ -e /dev/ttyGS0 ]; then
    log "starting shell on ttyGS0"
    (
      while true; do
        echo "nx563j diag shell" > /dev/ttyGS0
        setsid cttyhack sh -l <> /dev/ttyGS0 >&0 2>&1
        sleep 1
      done
    ) &
  fi

  # USB network shell.
  if [ -n "$NETFUNC" ]; then
    NETIF=usb0
    [ "$NETFUNC" = "ncm.usb0" ] && NETIF=usb0
    if ifconfig "$NETIF" 10.42.0.1 netmask 255.255.255.0 up 2>>"$LOG"; then
      cat > /udhcpd.conf <<'EOF'
start 10.42.0.10
end 10.42.0.50
interface usb0
opt subnet 255.255.255.0
opt router 10.42.0.1
opt dns 10.42.0.1
EOF
      udhcpd /udhcpd.conf >>"$LOG" 2>&1
      telnetd -l /bin/sh -p 23 >>"$LOG" 2>&1
      log "usb net up: 10.42.0.1, telnetd on :23"
    else
      log "usb net interface $NETIF failed"
    fi
  fi
fi

# --- late diagnostics -------------------------------------------------------
log "== block devices after gadget setup =="
ls -la /sys/class/block 2>&1 | tee -a "$LOG"
run_logged cat /proc/partitions
run_logged dmesg

log "NX563J diag init ready; heartbeat every 30s"

# --- heartbeat --------------------------------------------------------------
while true; do
  sleep 30
  {
    echo "== heartbeat $(date 2>/dev/null) =="
    dmesg | tail -n 20
  } >> "$LOG" 2>&1
done
