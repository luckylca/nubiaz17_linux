#!/bin/sh
# NX563J diagnostic initramfs init — USB network shell + persistent rootfs.
#
# Proven on device: kernel reaches userspace, UDC binds, NCM enumerates.
# This edition brings up usb0 with a static IP, serves DHCP to the host,
# starts telnetd for a shell, keeps a read-only log LUN, mirrors all
# diagnostics into the recovery2 (sde20) log partition, mounts the Alpine
# rootfs from userdata (sda10), and runs its /root/rc.boot (dropbear SSH).

PATH=/bin:/sbin:/usr/bin:/usr/sbin
LOGDEV=""

/bin/busybox --install -s /bin 2>/dev/null

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null

if ! mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
  mount -t tmpfs tmpfs /dev 2>/dev/null
  mknod -m 600 /dev/console c 5 1 2>/dev/null
  mknod -m 666 /dev/null c 1 3 2>/dev/null
  mknod -m 644 /dev/kmsg c 1 11 2>/dev/null
  mdev -s 2>/dev/null
fi

# telnetd and other pty users need devpts.
mknod -m 666 /dev/ptmx c 5 2 2>/dev/null
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null

mkdir -p /config /mnt/logdisk
mount -t configfs none /config 2>/dev/null

# recovery2 raw log channel (sde20), if present.
i=0
while [ $i -lt 30 ]; do
  if [ -b /dev/sde20 ]; then LOGDEV=/dev/sde20; break; fi
  if [ ! -e /dev/sde20 ] && [ -d /sys/block/sde/sde20 ]; then
    mknod /dev/sde20 b 8 84 2>/dev/null && LOGDEV=/dev/sde20 && break
  fi
  sleep 1
  i=$((i + 1))
done

SLOT=0
mark() {
  [ -n "$LOGDEV" ] || return 0
  echo "STAGE $SLOT: $*" | dd of="$LOGDEV" bs=512 seek=$SLOT conv=notrunc 2>/dev/null
  SLOT=$((SLOT + 1))
}

mark "init alive; kernel $(uname -r 2>&1)"

# --- USB gadget ---------------------------------------------------------------
G=/config/usb_gadget/nx563j
NETFUNC=""
mkdir -p "$G" 2>/dev/null && cd "$G" && {
  echo 0x1d6b > idVendor 2>/dev/null
  echo 0x0104 > idProduct 2>/dev/null
  echo 0x0100 > bcdDevice 2>/dev/null
  echo 0x0200 > bcdUSB 2>/dev/null
  mkdir -p strings/0x409 2>/dev/null
  echo "nx563j-diag-0001" > strings/0x409/serialnumber 2>/dev/null
  echo "nubia-linux" > strings/0x409/manufacturer 2>/dev/null
  echo "NX563J diagnostic gadget" > strings/0x409/product 2>/dev/null

  for f in ncm.usb0 ecm.usb0 rndis.usb0 acm.GS0; do
    if mkdir -p "functions/$f" 2>/dev/null; then
      [ -z "$NETFUNC" ] && case "$f" in acm.*) ;; *) NETFUNC="$f";; esac
      mark "function ok: $f"
    fi
  done

  # Read-only log LUN as last-resort exfiltration.
  if mkdir -p functions/mass_storage.usb0 2>/dev/null; then
    dd if=/dev/zero of=/logdisk.img bs=1M count=8 2>/dev/null
    if mkfs.vfat /logdisk.img >/dev/null 2>&1; then
      dmesg > /dmesg-early.txt 2>&1
      if mount -o loop /logdisk.img /mnt/logdisk 2>/dev/null; then
        uname -a > /mnt/logdisk/uname.txt
        cat /proc/cmdline > /mnt/logdisk/cmdline.txt
        cp /dmesg-early.txt /mnt/logdisk/ 2>/dev/null
        umount /mnt/logdisk
      fi
      echo 1 > functions/mass_storage.usb0/lun.0/ro 2>/dev/null
      echo /logdisk.img > functions/mass_storage.usb0/lun.0/file 2>/dev/null
      mark "log LUN ok"
    else
      rmdir functions/mass_storage.usb0 2>/dev/null
      mark "mkfs.vfat failed; log LUN skipped"
    fi
  fi

  mkdir -p configs/c.1/strings/0x409 2>/dev/null
  echo "nx563j diag" > configs/c.1/strings/0x409/configuration 2>/dev/null
  echo 500 > configs/c.1/MaxPower 2>/dev/null

  for f in ncm.usb0 ecm.usb0 rndis.usb0 acm.GS0 mass_storage.usb0; do
    [ -d "functions/$f" ] && ln -sf "functions/$f" configs/c.1/ 2>/dev/null
  done

  UDC=$(ls /sys/class/udc 2>/dev/null | head -n 1)
  if [ -n "$UDC" ]; then
    echo "$UDC" > UDC 2>/dev/null
    mark "bound $UDC"
  else
    mark "no UDC"
  fi
}

# --- USB network ---------------------------------------------------------------
if [ -n "$NETFUNC" ]; then
  # usb0 appears once the host enumerates and configures the gadget.
  i=0
  while [ $i -lt 60 ] && [ ! -d /sys/class/net/usb0 ]; do
    sleep 1
    i=$((i + 1))
  done
  if [ -d /sys/class/net/usb0 ]; then
    ifconfig usb0 10.42.0.1 netmask 255.255.255.0 up 2>/dev/null
    cat > /udhcpd.conf <<'EOF'
start 10.42.0.10
end 10.42.0.50
interface usb0
opt subnet 255.255.255.0
opt router 10.42.0.1
opt dns 10.42.0.1
EOF
    udhcpd /udhcpd.conf 2>/dev/null
    telnetd -l /bin/sh -p 23 2>/dev/null
    mark "usb0 up 10.42.0.1 telnetd on :23 (waited ${i}s)"
  else
    mark "usb0 never appeared"
  fi
fi

# Serial console if the kernel has gadget serial.
if [ -e /dev/ttyGS0 ]; then
  mark "ttyGS0 present, starting console"
  (
    while true; do
      echo "nx563j diag shell" > /dev/ttyGS0
      setsid cttyhack sh -l <> /dev/ttyGS0 >&0 2>&1
      sleep 1
    done
  ) &
fi

# --- persistent rootfs on userdata (sda10) --------------------------------------
ROOTFS=/mnt/rootfs
mkdir -p $ROOTFS
i=0
while [ $i -lt 30 ]; do
  [ -b /dev/sda10 ] && break
  if [ ! -e /dev/sda10 ] && [ -d /sys/block/sda/sda10 ]; then
    mknod /dev/sda10 b 8 10 2>/dev/null && break
  fi
  sleep 1
  i=$((i + 1))
done
if [ -b /dev/sda10 ]; then
  if mount -t ext4 -o noatime /dev/sda10 $ROOTFS 2>/dev/null \
  || mount /dev/sda10 $ROOTFS 2>/dev/null; then
    mark "rootfs mounted from sda10 (waited ${i}s)"
    # Boot-target selection: the userdata filesystem can carry several
    # rootfs side by side. /boot-target naming "ubuntu" (and an
    # executable /ubuntu/root/rc.boot.ubuntu) chroots into the Ubuntu
    # 24.04 base at /ubuntu instead of the Alpine mini-rootfs at /.
    # Absent or broken flag -> Alpine, so a bad Ubuntu experiment can
    # never brick the boot.
    TARGET=$ROOTFS
    RCSCRIPT=/root/rc.boot
    if grep -q "^ubuntu" $ROOTFS/boot-target 2>/dev/null \
    && [ -x $ROOTFS/ubuntu/root/rc.boot.ubuntu ]; then
      TARGET=$ROOTFS/ubuntu
      RCSCRIPT=/root/rc.boot.ubuntu
      mark "boot target: ubuntu"
    fi
    mount -o bind /dev $TARGET/dev 2>/dev/null
    mount -t devpts devpts $TARGET/dev/pts 2>/dev/null
    mount -o bind /proc $TARGET/proc 2>/dev/null
    mount -o bind /sys $TARGET/sys 2>/dev/null
    if [ -x $TARGET$RCSCRIPT ]; then
      chroot $TARGET $RCSCRIPT
      mark "rootfs rc.boot done (ssh etc.)"
    else
      mark "no $TARGET$RCSCRIPT"
    fi
  else
    mark "sda10 mount failed"
  fi
else
  mark "sda10 never appeared"
fi

# --- diagnostics dump -----------------------------------------------------------
{
  echo "=== uname ==="; uname -a
  echo "=== cmdline ==="; cat /proc/cmdline
  echo "=== block ==="; ls /sys/class/block
  echo "=== partitions ==="; cat /proc/partitions
  echo "=== net ==="; ifconfig -a
  echo "=== meminfo ==="; head -5 /proc/meminfo
} > /diag-summary.txt 2>&1
[ -n "$LOGDEV" ] && {
  cat /diag-summary.txt | dd of="$LOGDEV" bs=512 seek=8192 conv=notrunc 2>/dev/null
  dmesg | dd of="$LOGDEV" bs=512 seek=64 conv=notrunc 2>/dev/null
}
mark "diag ready; heartbeat"

while true; do
  sleep 30
  [ -n "$LOGDEV" ] && dmesg | dd of="$LOGDEV" bs=512 seek=64 conv=notrunc 2>/dev/null
done
