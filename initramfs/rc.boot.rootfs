#!/bin/sh
# NX563J rootfs boot script — executed chrooted from the diag initramfs
# after /dev /proc /sys are bind-mounted in. Keep it fast and non-blocking;
# everything here runs before the initramfs heartbeat loop starts.
PATH=/bin:/sbin:/usr/bin:/usr/sbin

hostname nx563j 2>/dev/null

mkdir -p /etc/dropbear /root/.ssh /var/log
chmod 700 /root/.ssh 2>/dev/null

[ -f /etc/dropbear/dropbear_ed25519_host_key ] || \
  dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/dev/null 2>&1
[ -f /etc/dropbear/dropbear_rsa_host_key ] || \
  dropbearkey -t rsa -s 2048 -f /etc/dropbear/dropbear_rsa_host_key >/dev/null 2>&1

/usr/sbin/dropbear -E -p 22 2>/var/log/dropbear.log

# Display: unblank the cmd-mode panel, light the backlight, then hand the
# framebuffer to a long-lived holder. The fd MUST stay open or mdss
# re-suspends the panel within a second.
F=/sys/class/graphics/fb0
if [ -e /dev/fb0 ] && [ -x /root/fbdash/fbdash ]; then
  echo 1 > $F/msm_cmd_autorefresh_en 2>/dev/null
  nohup /root/fbdash/fbdash >/var/log/fbdash.log 2>&1 &
  sleep 1
  echo 128 > /sys/class/leds/lcd-backlight/brightness 2>/dev/null
  echo 1500 > /sys/class/leds/wled/brightness 2>/dev/null
fi
