#!/bin/sh
# ~/.xinitrc — NX563J touch desktop session (Ubuntu MATE).
#
# MATE = the official Ubuntu MATE flavor desktop: marco WM, mate-panel
# (top bar with brisk menu + clock, bottom bar with window list), caja
# file manager. CPU-rendered on fbdev (no GL) — marco needs no compositor.
# Touch is the pointer (evdev touch0 in xorg.conf); onboard provides the
# on-screen keyboard (autostart entry in /root/.config/autostart).
PATH=/bin:/sbin:/usr/bin:/usr/sbin
# Spawned from fbdash -> desktop.sh -> startx with no HOME in env — without
# this, MATE components resolve HOME=/ and read //.config for everything.
export HOME=/root
export USER=root
export XDG_CURRENT_DESKTOP=MATE
export XDG_SESSION_DESKTOP=mate

# Root-window gradient as a fallback backdrop; caja draws its own
# background on top once the session is up.
/root/setroot 2>/dev/null
[ -f /root/.Xdefaults ] && xrdb -merge /root/.Xdefaults 2>/dev/null

# Kiosk-style touch HMI: NEVER let X blank/DPMS the panel — fbdev answers
# DPMS-off with FBIOBLANK, which clears mdss autorefresh and the screen
# stays black until re-armed by hand.
xset s off 2>/dev/null
xset s noblank 2>/dev/null
xset -dpms 2>/dev/null

# mate-session starts marco / mate-panel / caja / mate-settings-daemon and
# honors ~/.config/autostart (onboard lives there). dbus-launch provides
# the session bus in our systemd-free rootfs. Ending the session (System
# menu -> Log Out, or X dying) drops back to the fbdash dashboard.
exec dbus-launch --exit-with-session mate-session
