#!/bin/sh
# ~/.xinitrc — NX563J touch desktop session (LXQt).
#
# LXQt = modern Qt desktop, single bottom taskbar (menu left, tasks center,
# tray+clock right). Pure CPU rendering on fbdev — no GL needed (openbox
# WM). Touch is the pointer (evdev touch0 in xorg.conf); onboard is the
# on-screen keyboard (XDG autostart in /root/.config/autostart).
PATH=/bin:/sbin:/usr/bin:/usr/sbin
# Spawned from fbdash -> desktop.sh -> startx with no HOME in env.
export HOME=/root
export USER=root
export XDG_CURRENT_DESKTOP=LXQt
export XDG_SESSION_DESKTOP=lxqt
# Qt honors Xft.dpi from the X resources for font sizing
export QT_AUTO_SCREEN_SCALE_FACTOR=0

# Root-window gradient fallback behind the desktop
/root/setroot 2>/dev/null
[ -f /root/.Xdefaults ] && xrdb -merge /root/.Xdefaults 2>/dev/null

# Single-user appliance: let any local process (ssh shells, screenshot
# pipeline, fake-logind tests) talk to X without cookie juggling. The X
# server has -nolisten tcp, so this is local-only.
xhost +local: 2>/dev/null

# Kiosk touch HMI: NEVER let X blank/DPMS the panel (fbdev FBIOBLANK
# clears mdss autorefresh -> black screen until manually re-armed)
xset s off 2>/dev/null
xset s noblank 2>/dev/null
xset -dpms 2>/dev/null

# Ending the session (main menu -> Leave -> Logout, or X dying) drops back
# to the fbdash dashboard.
exec dbus-launch --exit-with-session startlxqt
