#!/bin/sh
# ~/.xinitrc — NX563J touch desktop session.
# openbox WM + tint2 panel + xterm + on-screen keyboard; everything
# reachable by finger.
#
# NOTE: this build of matchbox-keyboard does NOT support a -g geometry
# flag (it exits with a usage error). The keyboard is docked at the
# bottom of the panel by an openbox application rule instead — see
# openbox-matchbox-keyboard.xml in this directory, which is merged into
# /etc/xdg/openbox/rc.xml (matches the window title "Keyboard").
PATH=/bin:/sbin:/usr/bin:/usr/sbin

xsetroot -solid "#203040" 2>/dev/null
xterm -geometry 60x20+20+20 -fa "WenQuanYi Micro Hei" -fs 14 &
tint2 &
# on-screen keyboard; openbox docks it at the bottom via the rc.xml rule
matchbox-keyboard &
exec openbox
